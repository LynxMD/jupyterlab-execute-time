{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "react",
    "module": "node20",
    "moduleResolution": "node16",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "preserveWatchOutput": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "strictNullChecks": false,
    "target": "es2020",
    "types": ["mocha"]
  },
  "include": ["*", "../src/*"]
}
